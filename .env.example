# Citadel local development environment variables.
# Copy this file to .env and source it before running citadel or the compose stack.
#
#   cp .env.example .env
#   source .env
#
# The defaults below match the compose stack in deploy/compose/docker-compose.yml.
# Change them only when the stack uses non-default credentials or ports.

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=citadel
RABBITMQ_DEFAULT_PASS=citadel
RABBITMQ_AMQP_URL=amqp://citadel:citadel@127.0.0.1:5672/
RABBITMQ_MANAGEMENT_URL=http://citadel:citadel@127.0.0.1:15672

# --- WireMock ---
WIREMOCK_URL=http://127.0.0.1:9090
WIREMOCK_ADMIN_URL=http://127.0.0.1:9090/__admin

# --- Event Trigger ---
EVENT_TRIGGER_URL=http://127.0.0.1:8081

# --- Event Capture ---
EVENT_CAPTURE_URL=http://127.0.0.1:8082

# --- Application ---
APP_URL=http://127.0.0.1:5000

# --- Application Database (host-side address for citadel CLI) ---
APP_DB_DSN=postgres://citadel:citadel@127.0.0.1:5432/citadel?sslmode=disable

# --- Optional: CDC Postgres shadow (requires cdc-postgres profile) ---
# CDC_POSTGRES_DB=upstream
# CDC_POSTGRES_USER=citadel
# CDC_POSTGRES_PASSWORD=citadel

# --- Optional: CDC SQL Server shadow (requires cdc-sqlserver profile) ---
# CDC_SQLSERVER_SA_PASSWORD=Citadel!Passw0rd
# CDC_SQLSERVER_DB=upstream
# CDC_SQLSERVER_POLL_INTERVAL=1
